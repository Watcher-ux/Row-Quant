{
  "enabled": true,
  "name": "Engine tests on save",
  "description": "When an engine source file is saved, run the test suite and report failures against the semantics.md invariants. Report only, no edits.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["src/engine/**/*.ts"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `npm test`. If anything fails, report which test failed and which invariant from .kiro/steering/semantics.md it checks. Do not edit any files."
  }
}
