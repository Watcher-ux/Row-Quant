{
  "enabled": true,
  "name": "Spec change to README",
  "description": "When a spec file changes, keep the README's 'How Kiro was used' section current.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [".kiro/specs/**/*.md"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Update the 'How Kiro was used' section of README.md (create it at the end if missing) with a 2-3 line summary of what changed in the spec that was just edited. Leave the rest of README.md unchanged."
  }
}
